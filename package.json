{
  "name": "anima-spellbook",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix && prettier --write \"src/**/*.{ts,css,html}\"",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "alpinejs": "3.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/alpinejs": "3.13.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-alpine": "1.0.0",
    "jsdom": "^30.1.3",
    "prettier": "3.3.0",
    "ts-api-utils": "^1.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}